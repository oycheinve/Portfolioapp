# Konta użytkowników w chmurze (Supabase) – skopiuj do .env.local i uzupełnij (Project Settings → API).
# Bez tych zmiennych aplikacja działa lokalnie; serwer można też wpisać w Ustawieniach → „Konto i synchronizacja w chmurze”.
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=twoj-klucz-anon-public

# Powiadomienia Web Push (opcjonalnie) – klucze VAPID: npx web-push generate-vapid-keys
# Klucz publiczny w aplikacji (wbudowywany przy budowie):
VITE_VAPID_PUBLIC_KEY=
# Tylko na serwerze (Vercel → Settings → Environment Variables; nie dodawaj prefiksu VITE_):
# VAPID_PUBLIC_KEY=   (ten sam co VITE_VAPID_PUBLIC_KEY)
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:twoj@email.pl
# SUPABASE_URL=https://twoj-projekt.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   (Project Settings → API → service_role – tajny!)
# CRON_SECRET=   (dowolny długi losowy ciąg; ten sam w harmonogramie pg_cron)

# ── Podsumowania AI w Newsach (/api/news-summary, Google Gemini) – tylko serwer (Vercel), NIGDY z prefiksem VITE_ ──
# Darmowy klucz: Google AI Studio → https://aistudio.google.com/app/apikey („Create API key”)
# GEMINI_API_KEY=   (albo GOOGLE_API_KEY)
# GEMINI_MODEL=gemini-2.5-flash   (opcjonalnie inny model; gemini-1.5-flash został wycofany przez Google)
# Z podsumowań korzystają zalogowani użytkownicy (weryfikacja sesji przez SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY).
# AI_ALLOW_ANON=1   (opcjonalnie: bez logowania, np. lokalnie – każdy z dostępem do adresu zużywa limit API)

# ── Inflacja CPI (GUS) – /api/inflation-sync (codziennie przez Vercel Cron, vercel.json) i /api/inflation ──
# Wymaga SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (jak wyżej) oraz CRON_SECRET (Vercel Cron wysyła go w nagłówku).
# GUS_CPI_CSV_URL=   (opcjonalnie: inny adres pliku GUS „Miesięczne wskaźniki cen towarów i usług konsumpcyjnych”)
